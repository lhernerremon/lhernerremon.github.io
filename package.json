    "dayjs": "1.11.20",
    "dayjs-nuxt": "2.1.11",
    "nuxt": "4.5.2",
    "vue": "3.5.41",
    "vue-router": "5.0.4"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.16.0",
    "eslint": "10.8.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
